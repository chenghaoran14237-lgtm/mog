APP_NAME=MOG Medical Audit
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000

# Local demo default. Change this for your local MySQL setup.
DATABASE_URL=mysql+pymysql://root:password@127.0.0.1:3306/mog_v2?charset=utf8mb4

# Development can use a simple value. Production must use a long random secret.
AUTH_SECRET_KEY=dev-only-change-me
AUTH_TOKEN_EXPIRE_MINUTES=60

# Development defaults keep docs, /api-test, and schema sync enabled.
# In production these default to disabled unless explicitly set.
DOCS_ENABLED=true
ENABLE_API_TEST_PAGE=true
AUTO_SYNC_DATABASE_SCHEMA=true

# Leave empty in same-origin production deployments, or set a comma-separated allowlist.
CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CORS_ALLOW_CREDENTIALS=true

UPLOAD_MAX_BYTES=20971520
UPLOAD_ALLOWED_CONTENT_TYPES=image/png,image/jpeg,application/pdf,text/plain,application/octet-stream

OCR_PROVIDER=auto
OCR_BASE_URL=
OCR_MODEL=
OCR_API_KEY=
OCR_PROVIDER_SECRET_REF=
OCR_PROVIDER_VARIANT=
OCR_TIMEOUT_SECONDS=30
OCR_MAX_RETRIES=1
OCR_MAX_IMAGE_PAGES=4
OCR_ENABLE_PDF_FALLBACK=false

NORMALIZATION_PROVIDER=rule_based
NORMALIZATION_PROVIDER_BASE_URL=
NORMALIZATION_PROVIDER_MODEL=
NORMALIZATION_PROVIDER_API_KEY=
NORMALIZATION_PROVIDER_TIMEOUT_SECONDS=120
NORMALIZATION_PROVIDER_MAX_RETRIES=1

STORAGE_PROVIDER=database_inline

LLM_PROVIDER=stub
LLM_PROVIDER_BASE_URL=
LLM_PROVIDER_MODEL=
LLM_PROVIDER_API_KEY=
LLM_PROVIDER_TIMEOUT_SECONDS=30
LLM_PROVIDER_MAX_RETRIES=0
